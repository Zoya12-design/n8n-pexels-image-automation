          "id": "njCArJSEk1FADW7O",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.total_results }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ]
        },
        "options": {}
      },
      "id": "33e6c8d3-f098-4867-bc46-5350b34fdf0d",
      "name": "Check Images Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        688,
        472
      ]
    },
    {
      "parameters": {
        "jsCode": "const keyword = $input.first().json.chatInput || 'image';\nconst photos = $input.first().json.photos || [];\n\nreturn photos.map((photo, index) => ({\n  json: {\n    url: photo.src.original,\n    fileName: `${keyword}_${index + 1}.jpg`\n  }\n}));"
      },
      "id": "bcda0a77-7326-44ef-91d1-1bfa3ac70ccc",
      "name": "Format Image Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        376
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "134894df-95ed-499e-8db9-cd79ebc5d4dc",
      "name": "Download Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
