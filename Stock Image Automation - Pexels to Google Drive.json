        "name": "={{ $json.fileName }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "1D8dIZ-4juNPLZv2131TnyU8g-8B0Psdf",
          "mode": "list",
          "cachedResultName": "automation",
          "cachedResultUrl": "https://drive.google.com/drive/folders/1D8dIZ-4juNPLZv2131TnyU8g-8B0Psdf"
